# Local development
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./safenestt.db
CORS_ORIGINS=http://localhost:5173

# Production Docker stack
POSTGRES_DB=safenestt
POSTGRES_USER=safenestt
POSTGRES_PASSWORD=replace-with-a-strong-database-password
SESSION_SECRET=replace-with-a-long-random-secret

# Private SafeNestT AI service (never expose these in the browser)
SAFENESTT_AI_BASE_URL=
SAFENESTT_AI_API_KEY=
